# 统一 LF 行尾，避免 CRLF/LF 换行噪声污染 diff（数据/脚本/场景/资源全部 LF）
* text=auto

*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.py    text eol=lf
*.ps1   text eol=lf
*.sh    text eol=lf
*.cfg   text eol=lf
*.csv   text eol=lf

# 二进制资源不归一化
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ogg   binary
*.wav   binary
*.ttf   binary
*.otf   binary
*.pck   binary
*.zip   binary
