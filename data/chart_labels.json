  "hazards": [
    {"text": "七洲洋", "lon": 111.4, "lat": 19.9, "tier": "mid", "quote": "去怕七洲，回怕昆侖", "source": "monsoon.md §4 H1；《夢粱錄》卷十二「迤邐過七洲洋，舟中測水，約有七十余丈」", "confidence": "高"},
    {"text": "千里長沙・萬里石床", "lon": 112.3, "lat": 16.5, "tier": "mid", "quote": "東則千里長沙、萬里石床，渺茫無際，天水一色，舟舶來往，惟以指南針為則", "source": "monsoon.md §4 H3；《諸蕃志》卷下海南（《嶺外代答》作「長砂石塘」）", "confidence": "中"},
    {"text": "三合流", "lon": 108.8, "lat": 18.2, "tier": "near", "quote": "南舶往來，必衝三流之中，得風一息，可濟。苟入險無風，舟不可出，必瓦解于三流之中", "source": "monsoon.md §4 H4；《嶺外代答》卷一（位置存疑）", "confidence": "低"},
    {"text": "三合溜", "lon": 110.2, "lat": 20.2, "tier": "near", "quote": "中流號三合溜，涉此無風濤，則舟人舉手相賀", "source": "monsoon.md §4 H5；《諸蕃志》卷下海南", "confidence": "高"},
    {"text": "落漈", "lon": 119.9, "lat": 23.35, "tier": "mid", "quote": "近瑠求則謂之落漈，漈者水趨下而不回也。凡西岸漁舟到彭湖已下，遇颶風發作，漂流落漈，回者百一", "source": "monsoon.md §4 H6；《元史·瑠求傳》（元人语，替代清代「黑水溝」）；critic §4.1 实测：报告坐标 120.2,23.2 在陆上 11.5 km，改用澎湖水道东侧海面（离岸 14 km，水深约 123 m）", "confidence": "中"},
    {"text": "半洋焦", "lon": 122.9, "lat": 30.3, "tier": "near", "quote": "洋中有石，曰半洋焦", "source": "monsoon.md §4 H11；《宣和奉使高麗圖經》（今地不明）", "confidence": "低"},
    {"text": "沙尾", "lon": 122.8, "lat": 31.9, "tier": "mid", "quote": "黃水洋，卽沙尾也。其水渾濁且淺", "source": "monsoon.md §4 H9；《圖經》卷三四「第二舟，至黃水洋中，三柁倂折」", "confidence": "中"},
    {"text": "急水門", "lon": 126.4, "lat": 37.6, "tier": "near", "quote": "水埶爲山峽所束，驚濤拍岸，轉石穿崖，喧豗如雷", "source": "monsoon.md §4 H14；《圖經》卷三九", "confidence": "中"},
    {"text": "黑山", "lon": 125.43, "lat": 34.68, "tier": "mid", "quote": "辰巳望見黑山，忽東南風暴，復遇海動，舟側欲傾", "source": "monsoon.md §4 H13；《圖經》卷三五、三九（兼岛名，今大黑山岛）", "confidence": "高"},
    {"text": "夾界山", "lon": 125.2, "lat": 34.2, "tier": "near", "quote": "正東望一山如屛，卽夾界山也。華夷，以此爲界限", "source": "monsoon.md §4 H12；《圖經》卷三五（兼岛名，今地存疑，候选可居岛）", "confidence": "低"}
  ],
