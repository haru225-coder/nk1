     "grade": "sepia",
     "fx": ["dust"],
     "transition_in": "fade",
     "shake": 0.0,
     "captions": [
      {"t": 0.4, "text": "西", "style": "seal", "pos": "right_vertical"},
      {"t": 0.9, "text": "白达", "style": "era", "pos": "right_vertical"},
      {"t": 1.8, "text": "旭烈兀大军西行，驼道上尘起如雾。", "style": "narration", "pos": "lower_left"},
      {"t": 4.6, "text": "三年之后，白达城破，黑衣大食亡。", "style": "narration", "pos": "lower_left"}
     ]
    },
    {
     "bg": "res://assets/bg_quanzhou_harbor.jpg",
     "duration": 9.0,
     "cam_from": [0.39, 0.39, 1.3],
     "cam_to": [0.43, 0.43, 1.18],
     "grade": "dawn",
     "fx": ["mist"],
     "transition_in": "ink",
     "shake": 0.0,
     "captions": [
      {"t": 0.8, "text": "泉州・刺桐港", "style": "era", "pos": "right_vertical"},
      {"t": 1.8, "text": "四方消息，终归一港。", "style": "narration", "pos": "lower_left"},
      {"t": 4.8, "text": "蕃舶如林，一潮一汐。", "style": "narration", "pos": "lower_left"}
     ]
    },
    {
     "bg": "res://assets/cutscene/cs_ziling_portrait.jpg",
     "duration": 11.0,
     "cam_from": [0.5, 0.74, 1.02],
     "cam_to": [0.52, 0.3, 1.1],
     "grade": "dusk",
     "fx": ["lantern_glow"],
     "transition_in": "fade",
     "shake": 0.0,
     "captions": [
      {"t": 0.8, "text": "兴化军・玉湖", "style": "era", "pos": "right_vertical"},
      {"t": 5.4, "text": "兴化玉湖陈氏子，名子龙。", "style": "narration", "pos": "lower_left"},
      {"t": 6.9, "text": "族中催他赴试，箧底却压着一纸泉州货引。", "style": "narration", "pos": "lower_left"},
      {"t": 9.0, "text": "债是真的。", "style": "line", "pos": "bottom"}
     ]
    },
    {
     "bg": "res://assets/bg_xinghua_harbor.jpg",
     "duration": 13.0,
     "cam_from": [0.5, 0.5, 1.0],
     "cam_to": [0.36, 0.62, 1.45],
     "grade": "dusk",
     "fx": ["mist"],
     "transition_in": "flash",
     "shake": 0.0,
     "captions": [
      {"t": 0.6, "text": "兴化海口・三月", "style": "era", "pos": "right_vertical", "hold": 6.0},
      {"t": 1.4, "text": "春雷。潮退，船搁在泥上。", "style": "narration", "pos": "lower_left", "hold": 5.0},
      {"t": 4.0, "text": "北去是福州、临安的官道；南下，是海。", "style": "narration", "pos": "lower_left", "hold": 2.8},
      {"t": 7.4, "text": "东亚海域立志传", "style": "title", "pos": "center"},
      {"t": 8.6, "text": "乙卯", "style": "seal", "pos": "center"}
     ]
    }
   ]
  },
  "ending_zhongsu": {
   "title": "结局：忠肃",
   "letterbox": true,
   "shots": [
    {
     "bg": "res://assets/cutscene/cs_xinghua_seawall.jpg",
