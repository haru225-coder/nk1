     "grade": "dusk",
     "fx": ["dust"],
     "transition_in": "ink",
     "shake": 0.0,
     "captions": [
      {"t": 1.0, "text": "宋理宗宝祐三年", "style": "era", "pos": "right_vertical"},
      {"t": 2.4, "text": "是岁乙卯。北方之兵未息，东南之海方盛。", "style": "narration", "pos": "lower_left"},
      {"t": 5.6, "text": "天下之势，试言其略。", "style": "narration", "pos": "lower_left"}
     ]
    },
    {
     "bg": "res://assets/cutscene/cs_north_mongol.jpg",
     "duration": 9.0,
     "cam_from": [0.53, 0.46, 1.08],
     "cam_to": [0.33, 0.56, 1.55],
     "grade": "dusk",
     "fx": ["dust"],
     "transition_in": "fade",
     "shake": 0.0,
     "captions": [
      {"t": 0.4, "text": "北", "style": "seal", "pos": "right_vertical"},
      {"t": 0.9, "text": "漠北", "style": "era", "pos": "right_vertical"},
      {"t": 1.8, "text": "蒙古大汗蒙哥在位，控弦之士，遍于漠北。", "style": "narration", "pos": "lower_left"},
      {"t": 5.0, "text": "忽必烈既下大理，兵锋已在宋之西南。", "style": "narration", "pos": "lower_left"}
     ]
    },
    {
     "bg": "res://assets/bg_linan.jpg",
     "duration": 9.0,
     "cam_from": [0.46, 0.54, 1.1],
     "cam_to": [0.6, 0.42, 1.35],
     "grade": "cold",
     "fx": ["rain", "mist"],
     "transition_in": "fade",
     "shake": 0.0,
     "captions": [
      {"t": 0.6, "text": "临安・行在", "style": "era", "pos": "right_vertical"},
      {"t": 1.6, "text": "湖上歌吹，终夜未歇。", "style": "narration", "pos": "lower_left"},
      {"t": 4.8, "text": "北来的流民，一船一船渡江。", "style": "narration", "pos": "lower_left"}
     ]
    },
    {
     "bg": "res://assets/bg_hakata.jpg",
     "duration": 8.0,
     "cam_from": [0.5, 0.5, 1.0],
     "cam_to": [0.61, 0.56, 1.3],
     "grade": "dusk",
     "fx": ["lantern_glow"],
     "transition_in": "fade",
     "shake": 0.0,
     "captions": [
      {"t": 0.4, "text": "东", "style": "seal", "pos": "right_vertical"},
      {"t": 0.9, "text": "日本・博多津", "style": "era", "pos": "right_vertical"},
      {"t": 1.8, "text": "宋商聚居于此，号为唐房。", "style": "narration", "pos": "lower_left"},
      {"t": 4.6, "text": "宋钱、瓷、绢东去，硫黄、宝刀西来。", "style": "narration", "pos": "lower_left"}
     ]
    },
    {
     "bg": "res://assets/cutscene/cs_south_champa.jpg",
     "duration": 8.0,
     "cam_from": [0.5, 0.52, 1.05],
     "cam_to": [0.42, 0.4, 1.35],
     "grade": "dusk",
     "fx": ["sea_spray"],
     "transition_in": "fade",
     "shake": 0.0,
     "captions": [
      {"t": 0.4, "text": "南", "style": "seal", "pos": "right_vertical"},
      {"t": 0.9, "text": "占城・三佛齐", "style": "era", "pos": "right_vertical"},
      {"t": 1.8, "text": "占城稻熟，三佛齐扼海峡之口。", "style": "narration", "pos": "lower_left"},
      {"t": 4.6, "text": "蕃舶乘风而至，岁无虚日。", "style": "narration", "pos": "lower_left"}
     ]
    },
    {
     "bg": "res://assets/cutscene/cs_west_caravan.jpg",
     "duration": 8.0,
     "cam_from": [0.37, 0.62, 1.35],
