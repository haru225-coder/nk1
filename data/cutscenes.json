     "grade": "cold",
     "fx": ["mist"],
     "transition_in": "ink",
     "shake": 0.0,
     "captions": [
      {"t": 0.6, "text": "一百多年后・福州台江", "style": "era", "pos": "right_vertical"},
      {"t": 1.2, "text": "江边没有庙。渔民出海前拜妈祖，只拜妈祖。", "style": "narration", "pos": "lower_left"},
      {"t": 3.8, "text": "二号封舟，空着。", "style": "narration", "pos": "lower_left"},
      {"t": 5.6, "text": "这个世界少了一位海神。也没有多出几条回来的船。", "style": "line", "pos": "bottom"}
     ]
    }
   ]
  },
