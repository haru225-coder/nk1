     "transition_in": "fade",
     "shake": 0.0,
     "captions": [
      {"t": 0.8, "text": "母亲与幼子扣在福州，说城里的人出来就放。", "style": "narration", "pos": "lower_left"},
      {"t": 3.4, "text": "史书上后来写：是年，兴化陷，守臣不知所终。", "style": "narration", "pos": "lower_left"},
      {"t": 6.0, "text": "城里那个人没有出来——因为城里没有那个人。", "style": "line", "pos": "bottom"}
     ]
    },
    {
     "bg": "res://assets/cutscene/cs_taijiang_dawn.jpg",
