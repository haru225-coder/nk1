            {
              "id": "jzh_pipa_write_no",
              "label": "不题",
              "text": "你把笔还给老人，站在壁前看别人的字。江上有船过，亭角的风铃响了一阵。",
              "cost": 0,
              "effects": {
                "scholar_tendency": 1
              }
            }
          ]
        }
      ]
    },
