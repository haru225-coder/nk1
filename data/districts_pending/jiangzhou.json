          "id": "jzh_pipa_write",
          "type": "choice",
          "label": "题壁",
          "text": "亭角还有一方空壁，守亭的老人把笔递过来，问你要不要落款。",
          "options": [
            {
              "id": "jzh_pipa_write_yes",
              "label": "题一行",
              "text": "你写了两句，没落姓名。老人把笔收回，等墨干了才用布盖上。",
              "cost": 10,
              "effects": {
                "fame": 1,
                "scholar_tendency": 1
              }
