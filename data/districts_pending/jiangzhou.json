      "name": "江州城与浔阳江码头",
      "kind": "dock",
      "pending_art": true,
      "bg": "bg_dist_jzh_cheng.jpg",
      "description": "江州城压在浔阳江南岸，城墙从江边折向内陆。码头的石阶被江水磨得发亮，漕船、盐船和茶船挨着泊，桅杆把江面切成一条条。",
      "interactions": [
        {
          "id": "jzh_cheng_watch",
          "type": "favour",
          "label": "看江",
          "text": "你站在码头上游的一段石堤，看江心的船队。船夫说，湖口起风时，这里的水会倒灌。",
          "cost": 0,
          "once_per": "month",
          "effects": {
            "network": 1,
            "sea_tendency": 1
          }
        },
        {
          "id": "jzh_cheng_berth",
          "type": "choice",
          "label": "让泊位",
          "text": "一条粮船进港，泊位只剩你船边的一线。船主隔着水问，能不能并一排。",
          "options": [
            {
              "id": "jzh_cheng_berth_yes",
              "label": "并排",
              "text": "你让船夫把缆绳抛过去。两条船靠稳，粮船上的脚夫先卸了半舱。",
              "cost": 0,
              "effects": {
                "network": 1,
                "merchant_credit": 1
              }
            },
            {
              "id": "jzh_cheng_berth_no",
              "label": "不并",
              "text": "你让船夫把缆绳收紧。粮船在江心又转了一圈，才去下游寻泊。",
              "cost": 0,
              "effects": {
                "merchant_credit": 1
              }
            }
          ]
        },
        {
          "id": "jzh_cheng_rumor",
          "type": "rumor",
          "label": "听纲吏",
          "text": "纲吏翻着粮簿说，上江米纲被江防扣作军粮，两浙籴不足数，泉州米行跟着抬了盘子。",
          "cost": 12,
          "cooldown_days": 35,
          "port": "quanzhou",
          "good": "grain",
          "mul": 1.12
        }
      ]
    },
