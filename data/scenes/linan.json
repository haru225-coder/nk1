      "chapter": "chapter_2",
      "title": "贾府铺子",
      "location": "linan",
      "time": "午后",
      "objective": "贾府作保",
      "body": "城外河西有家绸缎铺，门帘绣着贾府暗记。伙计打量你许久，才放你入内。\n\n【贾府管事】：「兴化来的读书人？城隍庙见过。」\n\n　　他指尖敲着柜台，像敲你的骨头。\n\n【贾府管事】：「太学保书，贾府能写。代价也简单——替贾府在刺桐港盯一个人：林伯渊。」",
      "investigations": [
        {
          "label": "出示城隍庙碎银",
          "text": "管事眼角一挑：「捡得倒快。贾府的银子，从来不白给。」",
          "requires_story_flag": "jia_silver_taken",
          "once_flag": "jia_linan_silver_shown",
          "effects": {
            "fame": -1,
            "story_flag": "jia_linan_silver_shown"
          }
        }
      ],
      "choices": [
        {
          "label": "答应作保，接下眼线差事",
          "next": "chapter2_jia_deal",
          "effects": {
            "story_flag": "jia_spy_agreed",
            "pu_attention": 3,
            "fame": -2
          }
        },
        {
          "label": "只求保书，不答应盯人",
          "next": "chapter2_jia_deal",
          "effects": {
            "story_flag": "jia_spy_refused",
            "fame": 1
          },
          "narration": "管事冷笑：「读书人，还价？那就多掏三十贯。」"
        },
        {
          "label": "掉头离开",
          "next": "chapter2_path_select"
        }
      ],
      "bg": "res://assets/bg_quanzhou_office.jpg"
