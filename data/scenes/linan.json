          "next": "chapter2_path_select",
          "effects": {
            "fame": 2,
            "pu_attention": 2
          },
          "narration": "纸屑落进运河，像一群白蛾。管事没追，只在你背后说了句：「你会回来的。」"
        }
      ],
      "bg": "res://assets/bg_quanzhou_office.jpg"
