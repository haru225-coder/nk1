{
  "templates": {
    "port": {
      "facility_source": "scene_data.facilities",
      "facility_filter": "facility_available",
      "static_actions": [
        {
          "id": "log",
          "type": "open_log",
          "label": "日志",
          "icon": "res://assets/ui/icons/icon_log.png",
          "always_visible": true
        },
        {
          "id": "storybook",
          "type": "open_storybook",
          "label": "札册",
          "icon": "res://assets/ui/icons/icon_log.png",
          "always_visible": true
        },
        {
          "id": "depart",
          "type": "navigate",
          "label": "出港",
          "icon": "res://assets/ui/icons/icon_sail.png",
          "target": "world_map",
          "always_visible": true
        }
      ],
      "choice_source": "scene_data.choices",
      "choice_filter": "choice_available"
    },
    "investigation": {
      "static_actions": [
        {
          "id": "log",
          "type": "open_log",
          "label": "日志",
          "icon": "res://assets/ui/icons/icon_log.png",
          "always_visible": true
        },
        {
          "id": "storybook",
          "type": "open_storybook",
          "label": "札册",
          "icon": "res://assets/ui/icons/icon_log.png",
          "always_visible": true
        }
      ]
    },
    "title": {
      "static_actions": [
        {
          "id": "start",
          "type": "navigate",
          "label": "开始",
          "icon": "res://assets/ui/icons/icon_start.png",
          "target": "port_quanzhou",
          "always_visible": true
        },
        {
          "id": "continue",
          "type": "navigate",
          "label": "继续",
          "icon": "res://assets/ui/icons/icon_continue.png",
          "target": "port_quanzhou",
          "always_visible": true
        }
      ]
    }
  }
}
