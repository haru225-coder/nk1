  "slot_rule": {
    "cannon_slots": "ships.json 的 cannon_slots 读作「舷位」：一位一队手持弓弩（五人）。齐射一发 = 一位的一阵（Ship._fire_broadside 的 shots = maxi(1, cannon_slots) 照旧）；床子弩、旋风炮另按 loadouts.heavy 装，不占舷位",
    "min_positions": 1,
    "enemy_projectile_cap": 2,
    "enemy_cap_ref": "WorldMap.COMBAT_CANNON_CAP；敌船 cannon_count = min(2, max(1, round(3 × scale))) 不变",
    "squad_hands": 5,
    "effect_scale": "一发的效力倍数 k = clamp(该舷弓弩手 ÷ (发数 × squad_hands), 0.2, 2.0)：画面上的发数跟舷位走，杀伤跟实有人手走（ReloadAmmo 现以 SQUAD 4 人一队、弓弩手不分舷实现，同一个意思）",
    "side_mix_rounding": "舷位按 share 四舍五入分给各兵器，差额补给 share 最大的那一种；至少一位",
    "loadout_lookup": ["pending_battle.enemy[].loadout", "sprite_loadouts[sprite]", "ship_fits[type].loadout_enemy"],
    "own_lookup": ["ship_fits[旗舰 type].loadout_own"],
    "ammo_persist": false,
    "ammo_note": "首版每战开场按 loadouts.ammo 满额；矢石跨战斗存量、港口补买要动 Fleet 存档，留下一轮"
  },
  "hit_rules": {
    "by": "physics",
    "note": "命中不掷骰：投射物照 spread_deg / range_spread_bu 散出去实飞，碰到受射面才算中。受射面建议顺船身挂一块胶囊形 Area2D（长轴顺船身，约船图长宽），船体碰撞圆（半径 24 px，move_and_slide 用）不动；这样横着的船好打、艏艉对着的难打，抛石落点沿射向散，艏艉对着反倒好中——受射面效应自己出来",
    "flat": "平射（弓弩、床弩、手掷）：飞行途中碰到即中",
    "lob": "抛射（旋风炮）：只在落点判中，落点 = 瞄点 ± range_spread_bu（沿射向）± 横向散布；min 以内放不了",
    "falloff": "eff 以内效力 1.0；eff 到 max 线性减到 0.4；max 以外不放",
    "wind_range": "顺风射程加、逆风减，幅度照 ManeuverModel.DOWNWIND_RANGE（参考风力、正顺正逆时 ±15%）再乘 weapons.wind_mul；横风把轻的矢往下风推",
    "height": "高舷往低舷射，每差一档（ship_fits.arms.freeboard）射程 +5%",
    "cover": "伤人乘目标 ship_fits.arms.cover；抛石从上往下砸，不看舷墙，取 0.8",
