; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="nk1"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

; 顺序即初始化顺序：GameManager 必须最先加载 JSON，Economy/Fleet 的 _ready 依赖它。
GameManager="*res://scripts/GameManager.gd"
Calendar="*res://scripts/core/Calendar.gd"
Economy="*res://scripts/core/Economy.gd"
Fleet="*res://scripts/core/Fleet.gd"
Crew="*res://scripts/core/Crew.gd"
Voyage="*res://scripts/core/Voyage.gd"
GameState="*res://scripts/GameState.gd"
SaveLoad="*res://scripts/core/SaveLoad.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
